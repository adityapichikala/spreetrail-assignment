// Prisma schema for Shared Expense Management Application
// Based on the ERD and domain model specifications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @default(true) @map("is_active")

  // Relations
  groupMemberships    GroupMembership[]    @relation("UserGroupMembership")
  expenses            Expense[]            @relation("UserExpenses")
  settlementsFrom     Settlement[]         @relation("SettlementFromUser")
  settlementsTo       Settlement[]         @relation("SettlementToUser")
  importBatches       ImportBatch[]        @relation("UserImportBatches")
  auditLogs           AuditLog[]           @relation("UserAuditLogs")
  createdGroups       Group[]              @relation("GroupCreatedBy")
  createdExpenses     Expense[]            @relation("ExpenseCreatedBy")
  createdSettlements  Settlement[]         @relation("SettlementCreatedBy")
  expenseParticipants ExpenseParticipant[] @relation("UserExpenseParticipants")

  @@index([email])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")
  currency    String   @default("USD")

  // Relations
  createdByUser    User              @relation("GroupCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId  String
  groupMemberships GroupMembership[] @relation("GroupGroupMembership")
  expenses         Expense[]         @relation("GroupExpenses")
  settlements      Settlement[]      @relation("GroupSettlements")

  @@index([createdByUserId])
}

model GroupMembership {
  id        String    @id @default(uuid())
  group     Group     @relation("GroupGroupMembership", fields: [groupId], references: [id])
  groupId   String
  user      User      @relation("UserGroupMembership", fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime  @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Constraints to prevent overlapping memberships
  @@unique([groupId, userId, joinedAt])
  @@index([groupId, userId])
}

model Expense {
  id             String   @id @default(uuid())
  group          Group    @relation("GroupExpenses", fields: [groupId], references: [id])
  groupId        String
  payer          User     @relation("UserExpenses", fields: [payerId], references: [id])
  payerId        String
  amount         Decimal  @default(0)
  currency       String   @default("USD")
  date           DateTime
  description    String
  splitType      String // EQUAL, PERCENTAGE, EXACT, UNEQUAL
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")
  exchangeRate   Decimal  @default(1.0) @map("exchange_rate")
  exchangeRateId String?

  // Relations
  createdByUser      User                 @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId    String
  participants       ExpenseParticipant[] @relation("ExpenseParticipants")
  exchangeRateEntity ExchangeRate?        @relation("ExpenseExchangeRate", fields: [exchangeRateId], references: [id])
  importedExpense    ImportedExpense?     @relation("ImportedExpenseToExpense")

  @@index([groupId])
  @@index([payerId])
  @@index([date])
  @@index([exchangeRateId])
}

model ExpenseParticipant {
  id         String   @id @default(uuid())
  expense    Expense  @relation("ExpenseParticipants", fields: [expenseId], references: [id])
  expenseId  String
  user       User     @relation("UserExpenseParticipants", fields: [userId], references: [id])
  userId     String
  percentage Decimal? // For PERCENTAGE split
  amount     Decimal? // For EXACT split
  notes      String?

  @@index([expenseId])
  @@index([userId])
}

model Settlement {
  id             String   @id @default(uuid())
  group          Group    @relation("GroupSettlements", fields: [groupId], references: [id])
  groupId        String
  fromUser       User     @relation("SettlementFromUser", fields: [fromUserId], references: [id])
  fromUserId     String
  toUser         User     @relation("SettlementToUser", fields: [toUserId], references: [id])
  toUserId       String
  amount         Decimal  @default(0)
  currency       String   @default("USD")
  date           DateTime
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")
  exchangeRate   Decimal  @default(1.0) @map("exchange_rate")
  exchangeRateId String?

  // Relations
  createdByUser      User          @relation("SettlementCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId    String
  exchangeRateEntity ExchangeRate? @relation("SettlementExchangeRate", fields: [exchangeRateId], references: [id])

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([date])
  @@index([exchangeRateId])
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal
  date         DateTime
  source       String? // Source of the rate (e.g., "ECB", "Manual")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations for conversion
  expenses    Expense[]    @relation("ExpenseExchangeRate")
  settlements Settlement[] @relation("SettlementExchangeRate")

  @@index([fromCurrency, toCurrency, date])
}

model ImportBatch {
  id            String    @id @default(uuid())
  user          User      @relation("UserImportBatches", fields: [userId], references: [id])
  userId        String
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  status        String // PENDING, PROCESSING, COMPLETED, FAILED
  rowCount      Int       @default(0) @map("row_count")
  importedCount Int       @default(0) @map("imported_count")
  anomalyCount  Int       @default(0) @map("anomaly_count")
  metadata      Json?

  // Relations
  importedExpenses ImportedExpense[] @relation("ImportBatchImportedExpenses")
  importAnomalies  ImportedAnomaly[] @relation("ImportBatchImportedAnomalies")

  @@index([userId])
  @@index([status])
}

model ImportedExpense {
  id                String            @id @default(uuid())
  importBatch       ImportBatch       @relation("ImportBatchImportedExpenses", fields: [importBatchId], references: [id])
  importBatchId     String
  rawData           Json // Original CSV row as key-value pairs
  expense           Expense?          @relation("ImportedExpenseToExpense", fields: [expenseId], references: [id])
  expenseId         String?           @unique
  status            String // PENDING, IMPORTED, SKIPPED, MODIFIED
  anomalyIds        Json // References to ImportedAnomaly IDs
  importedAnomalies ImportedAnomaly[] @relation("ImportedExpenseImportedAnomalies")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([importBatchId])
  @@index([expenseId])
}

model ImportedAnomaly {
  id                   String          @id @default(uuid())
  importBatch          ImportBatch     @relation("ImportBatchImportedAnomalies", fields: [importBatchId], references: [id])
  importBatchId        String
  importedExpense      ImportedExpense @relation("ImportedExpenseImportedAnomalies", fields: [importedExpenseId], references: [id])
  importedExpenseId    String
  anomalyType          String // From predefined list
  severity             String // LOW, MEDIUM, HIGH, CRITICAL
  description          String
  detectionLogic       String
  suggestedResolution  String
  userResolution       String? // APPROVE_SUGGESTED, MANUAL_CORRECTION, SKIP_ROW
  manualCorrectionData Json?
  createdAt            DateTime        @default(now()) @map("created_at")
  resolvedAt           DateTime?       @map("resolved_at")
  resolvedBy           String?         @map("resolved_by")

  @@index([importBatchId])
  @@index([importedExpenseId])
  @@index([anomalyType])
  @@index([severity])
}

model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id])
  userId     String?
  action     String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entityType String // USER, GROUP, EXPENSE, SETTLEMENT, etc.
  entityId   String // UUID of the entity
  changes    Json? // Details of what changed
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
